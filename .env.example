# Tradovate credentials
TRADOVATE_USERNAME=your_username
TRADOVATE_PASSWORD=your_password
TRADOVATE_APP_ID=Sample App
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=your_cid
TRADOVATE_SECRET=your_secret

# Set to "true" for demo/sim account, "false" for live
TRADOVATE_DEMO=true

# Secret token you set in TradingView webhook URL to prevent unauthorized calls
WEBHOOK_SECRET=change_me_to_a_strong_random_string
