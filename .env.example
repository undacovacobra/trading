# Tradovate web login credentials (your prop firm account)
TRADOVATE_EMAIL=your@email.com
TRADOVATE_PASSWORD=your_password

# Secret token included in every TradingView webhook to reject unauthorized calls
WEBHOOK_SECRET=change_me_to_a_strong_random_string

# Set to "true" to run browser headlessly (no window), "false" to watch it for debugging
HEADLESS=true
