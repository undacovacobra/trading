# ---- Required ---------------------------------------------------------------
# Random string (>= 16 chars) that TradingView includes in every alert body.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Dashboard login (HTTP basic auth).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ---- Database ---------------------------------------------------------------
# SQLite for local development; PostgreSQL recommended in production.
DATABASE_URL=sqlite:///./data/options_bridge.db
# docker-compose only:
POSTGRES_PASSWORD=
DOMAIN=bridge.example.com

# ---- Market data ------------------------------------------------------------
# simulated = synthetic chain (dashboard shows a warning)
# robinhood = Agentic MCP read-only tools (needs schema mapping first, see README)
MARKET_DATA_PROVIDER=simulated
SIMULATED_MARKET_WALK=true

# ---- Webhook hardening ------------------------------------------------------
REQUIRE_HTTPS=false
TRUST_PROXY_HEADERS=false
TRADINGVIEW_IP_ALLOWLIST=false
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
WEBHOOK_MAX_BODY_BYTES=16384

# ---- Robinhood Agentic Trading (Phase 4) -------------------------------------
ROBINHOOD_MCP_URL=
ROBINHOOD_MCP_TOKEN=
ROBINHOOD_AGENTIC_ACCOUNT=
# Comma-separated extra READ-ONLY tool names found via `inspect` (order tools are refused).
ROBINHOOD_MCP_EXTRA_READ_TOOLS=

# ---- LIVE gate --------------------------------------------------------------
# LIVE requires this AND a typed confirmation in the dashboard.
LIVE_TRADING=false
# After a restart LIVE comes back PAUSED (or OBSERVE if flat) unless this is true.
LIVE_RESUME_ON_RESTART=false

LOG_LEVEL=INFO
